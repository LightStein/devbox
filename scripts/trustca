#!/usr/bin/env bash
# trustca - make one internal host's CA trusted by everything in the box.
#
#   trustca <host>[:port] ...     trust these hosts
#   trustca --add <name> <file>   import a CA you already have as PEM
#   trustca --list                show what is trusted
#   trustca --rm <name>           stop trusting one
#   trustca --rebuild             recompose the bundle from what is stored
#
# The cluster injects its trusted CA bundle at
# /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem, but that covers only what
# the cluster itself has been told to trust. Hosts on a legacy cluster,
# Nexus and Jenkins are signed by an internal CA that is not in it, which is
# why Nexus failed with "unable to get issuer certificate" and why anything
# using Node would fail the same way - Node ignores the system store entirely
# and carries its own compiled-in list.
#
# This fetches a host's chain, stores the issuers, and composes one bundle that
# every runtime is pointed at: openssl, python, node, git and curl. Trusting a
# certificate the server itself handed you is trust-on-first-use, so the
# fingerprints are printed - but it is strictly better than the -k that this
# replaces, and it survives certificate renewal because the issuers are pinned
# rather than the leaf.
set -uo pipefail

HOME_DIR=${DEVBOX_HOME:-$HOME}
CA_DIR="${HOME_DIR}/.config/devbox/ca.d"
BUNDLE="${HOME_DIR}/.config/devbox/ca-bundle.pem"
SYSTEM_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

mkdir -p "$CA_DIR"

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }

rebuild() {
  {
    [ -r "$SYSTEM_BUNDLE" ] && cat "$SYSTEM_BUNDLE"
    for f in "$CA_DIR"/*.pem; do
      [ -f "$f" ] || continue
      cat "$f"
    done
  } > "${BUNDLE}.tmp" 2>/dev/null
  mv -f "${BUNDLE}.tmp" "$BUNDLE"
  echo "bundle: ${BUNDLE} ($(grep -c 'BEGIN CERTIFICATE' "$BUNDLE") certificates)"
}

add_host() {
  local spec="$1" host port out
  host="${spec%%:*}"
  port="${spec##*:}"
  [ "$port" = "$host" ] && port=443

  out=$(openssl s_client -showcerts -servername "$host" \
          -connect "${host}:${port}" </dev/null 2>/dev/null)
  if [ -z "$out" ]; then
    echo "trustca: could not connect to ${host}:${port}" >&2
    return 1
  fi

  # Prefer the issuers and skip the leaf: pinning a leaf works today and breaks
  # the next time the certificate is renewed.
  local issuers note=""
  issuers=$(echo "$out" | awk '/BEGIN CERT/{n++} n>1')

  if [ -z "$issuers" ]; then
    # Only a leaf was offered. OpenShift routers do this routinely - they serve
    # the certificate and nothing else - so refusing here is what left Nexus
    # and Jenkins untrusted while gitlab, which serves a full chain, worked.
    local leaf subject issuer
    leaf=$(echo "$out" | awk '/BEGIN CERT/,/END CERT/')
    subject=$(echo "$leaf" | openssl x509 -noout -subject 2>/dev/null | sed 's/^subject=//')
    issuer=$(echo "$leaf" | openssl x509 -noout -issuer 2>/dev/null | sed 's/^issuer=//')

    if [ -z "$leaf" ]; then
      echo "trustca: no certificate at all from ${host}:${port}" >&2
      return 1
    fi

    if [ "$subject" != "$issuer" ]; then
      # Issued by a CA the server does not send. Pinning the leaf does not
      # help: a trust anchor has to be able to issue, and a leaf cannot vouch
      # for itself - verified, both python and node still reject it. Say so
      # rather than writing a file that silently achieves nothing.
      echo "trustca: ${host} sent only its own certificate, and it was issued by" >&2
      echo "  ${issuer}" >&2
      echo "which the server does not send. There is nothing here to pin." >&2
      echo >&2
      echo "Get that CA as a PEM file - a colleague's browser trust store, or" >&2
      echo "whoever runs the host - and import it:" >&2
      echo "  trustca --add <name> /path/to/ca.pem" >&2
      return 1
    fi
    # Subject equals issuer, so this certificate signed itself - it is a root
    # in its own right and pinning it is correct.
    note="self-signed root"
    issuers="$leaf"
  fi

  echo "$issuers" > "${CA_DIR}/${host}.pem"
  echo "trusted ${host}:${port}${note:+  (${note})}"
  echo "$issuers" | awk '/BEGIN CERT/{c++} {print > ("/tmp/trustca-"c".pem")}' 2>/dev/null
  for f in /tmp/trustca-*.pem; do
    [ -f "$f" ] || continue
    openssl x509 -in "$f" -noout -subject -fingerprint -sha256 2>/dev/null \
      | sed 's/^/    /'
    rm -f "$f"
  done
}

case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
  --list)
    for f in "$CA_DIR"/*.pem; do
      [ -f "$f" ] || { echo "nothing trusted yet"; exit 0; }
      echo "$(basename "$f" .pem)"
    done
    exit 0 ;;
  --add)
    # For a CA that no server will hand you - an internal root obtained out of
    # band. Validated before it is stored, so a wrong or truncated paste fails
    # here rather than silently doing nothing.
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { usage; exit 2; }
    # Accept whatever a certificate export dialog produces. Browsers hand out
    # PKCS#7 for "certificate chain" and DER for "binary", and requiring PEM
    # meant a correct export was rejected as invalid.
    # PEM first, and by copy rather than through `openssl x509` - that reads
    # only the first certificate in a file, which silently truncated a
    # concatenated root+intermediate bundle to one.
    if grep -q "BEGIN CERTIFICATE" "$3" 2>/dev/null; then
      cp "$3" "${CA_DIR}/${2}.pem"
    elif ! openssl pkcs7 -print_certs -in "$3" -out "${CA_DIR}/${2}.pem" 2>/dev/null \
       && ! openssl pkcs7 -inform DER -print_certs -in "$3" -out "${CA_DIR}/${2}.pem" 2>/dev/null \
       && ! openssl x509 -inform DER -in "$3" -out "${CA_DIR}/${2}.pem" 2>/dev/null; then
      rm -f "${CA_DIR}/${2}.pem"
      echo "trustca: cannot read a certificate out of $3" >&2
      echo "  Tried PEM, DER and PKCS#7. Check the file is a certificate" >&2
      echo "  export and not a key or an archive." >&2
      exit 1
    fi
    if ! grep -q "BEGIN CERTIFICATE" "${CA_DIR}/${2}.pem"; then
      rm -f "${CA_DIR}/${2}.pem"
      echo "trustca: $3 contained no certificates" >&2
      exit 1
    fi
    echo "imported $(grep -c 'BEGIN CERTIFICATE' "${CA_DIR}/${2}.pem") certificate(s) as ${2}"
    # List what landed, from the converted file - the original may be PKCS#7
    # or DER, which `openssl x509` cannot read. crl2pkcs7 gets every subject
    # out of a bundle rather than only the first.
    openssl crl2pkcs7 -nocrl -certfile "${CA_DIR}/${2}.pem" 2>/dev/null \
      | openssl pkcs7 -print_certs -noout 2>/dev/null \
      | grep -E "^subject=" | sed 's/^/  /'
    rebuild; exit 0 ;;
  --rm)
    [ -n "${2:-}" ] || { usage; exit 2; }
    rm -f "${CA_DIR}/${2}.pem" && echo "removed $2"
    rebuild; exit 0 ;;
  --rebuild) rebuild; exit 0 ;;
esac

rc=0
for spec in "$@"; do
  add_host "$spec" || rc=1
done
rebuild
echo
echo "Already exported for new shells. In this one:"
echo "  export SSL_CERT_FILE=${BUNDLE}"
echo "Restart the editor (not just the tab) for extensions to pick it up."
exit $rc
